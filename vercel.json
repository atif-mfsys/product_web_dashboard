{
    "version": 2,
    "builds": [
        {
            "src": "build/web/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/icons/(.*)",
            "headers": {
                "cache-control": "public,max-age=31536000,immutable"
            },
            "dest": "/icons/$1"
        },
        {
            "src": "/manifest.json",
            "headers": {
                "cache-control": "no-cache"
            },
            "dest": "/manifest.json"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}